{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "cmds": []
        },
        "install": {
          "cmds": ["yarn install --check-cache"]
        },
        "build": {
          "cmds": ["yarn compile"]
        },
        "start": {
          "cmd": "yarn start"
        }
      }
    }
  }
}
